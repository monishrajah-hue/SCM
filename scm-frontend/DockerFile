# Stage 1: Build Angular App
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY . .
# // Angular Performance Optimization - Esbuild and Vite Build System
RUN npm run build --configuration=production

# Stage 2: Serve with Nginx
FROM nginx:alpine
# // Container Image - runnable package; Containerization - packaging apps
COPY --from=build /app/dist/scm-frontend/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]